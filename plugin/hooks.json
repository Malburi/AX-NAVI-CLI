{
  "description": "AX Navi 플러그인 훅 — 인덱스 신선도 · 사전 영향도 · 셸 소스 쓰기 승인 · 디스크 전체 검색 차단 · 평가 서브에이전트 1번 · EUC-KR 보존 · 고친 뒤 위치 읽기 화면 확인(packages/plugin/src/hooks.mjs, packages/provider-claude-cli/src/legacy-encoding-hook.mjs). axnavi CLI 로 실행하면 CLI 가 같은 일을 하고 이 훅들은 비킨다.",
  "hooks": {
    "SessionStart": [
      { "hooks": [{ "type": "command", "command": "node \"${CLAUDE_PLUGIN_ROOT}/packages/plugin/src/hooks.mjs\" session-start", "timeout": 180 }] }
    ],
    "UserPromptSubmit": [
      { "hooks": [{ "type": "command", "command": "node \"${CLAUDE_PLUGIN_ROOT}/packages/plugin/src/hooks.mjs\" prompt", "timeout": 60 }] }
    ],
    "PreToolUse": [
      { "matcher": "Bash|PowerShell|Agent|Task", "hooks": [{ "type": "command", "command": "node \"${CLAUDE_PLUGIN_ROOT}/packages/plugin/src/hooks.mjs\" pre-tool", "timeout": 20 }] },
      { "matcher": "Read|Edit|Write|MultiEdit", "hooks": [{ "type": "command", "command": "node \"${CLAUDE_PLUGIN_ROOT}/packages/provider-claude-cli/src/legacy-encoding-hook.mjs\" pre plugin" }] }
    ],
    "PostToolUse": [
      { "matcher": "Read|Edit|Write|MultiEdit", "hooks": [{ "type": "command", "command": "node \"${CLAUDE_PLUGIN_ROOT}/packages/provider-claude-cli/src/legacy-encoding-hook.mjs\" post plugin" }] }
    ],
    "PostToolUseFailure": [
      { "matcher": "Read|Edit|Write|MultiEdit", "hooks": [{ "type": "command", "command": "node \"${CLAUDE_PLUGIN_ROOT}/packages/provider-claude-cli/src/legacy-encoding-hook.mjs\" cleanup plugin" }] }
    ],
    "PermissionDenied": [
      { "matcher": "Read|Edit|Write|MultiEdit", "hooks": [{ "type": "command", "command": "node \"${CLAUDE_PLUGIN_ROOT}/packages/provider-claude-cli/src/legacy-encoding-hook.mjs\" cleanup plugin" }] }
    ],
    "Stop": [
      { "hooks": [
        { "type": "command", "command": "node \"${CLAUDE_PLUGIN_ROOT}/packages/provider-claude-cli/src/legacy-encoding-hook.mjs\" cleanup plugin" },
        { "type": "command", "command": "node \"${CLAUDE_PLUGIN_ROOT}/packages/plugin/src/hooks.mjs\" stop", "timeout": 180 }
      ] }
    ],
    "SessionEnd": [
      { "hooks": [{ "type": "command", "command": "node \"${CLAUDE_PLUGIN_ROOT}/packages/provider-claude-cli/src/legacy-encoding-hook.mjs\" cleanup plugin" }] }
    ]
  }
}
